{
  "name": "@muyianking/hooks",
  "type": "module",
  "version": "0.0.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/MuyianKing/hooks.git"
  },
  "keywords": [
    "MIT",
    "vue3",
    "hooks",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "module": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "build": "node ./script/build.js",
    "dev": "rslib build --watch",
    "test": "vitest run",
    "update-deps": "npm-check-updates && ncu -u && pnpm i",
    "commit": "git add . && git cz",
    "release": "node ./script/publish.js",
    "log": "conventional-changelog -p angular -i CHANGELOG.md -s"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/eslintrc": "^3.3.7",
    "@muyianking/build": "^0.0.4",
    "@muyianking/config": "^0.0.8",
    "@rslib/core": "^1.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.4",
    "commitizen": "^4.3.2",
    "conventional-changelog": "^8.1.3",
    "cz-git": "^1.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "fs-extra": "^11.4.1",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "inquirer": "^14.2.3",
    "lint-staged": "^17.6.0",
    "ora": "^9.4.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "resolutions": {
    "bin-wrapper": "npm:bin-wrapper-china"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
